/* Rofi Wallpaper Selector — Tokyo Night — embedded preview */

* {
    bg:           #1a1b26e6;
    bg-alt:       #24283be6;
    bg-selected:  #364a82e6;
    fg:           #c0caf5;
    fg-alt:       #565f89;
    border:       #89b4fa;
    accent:       #7aa2f7;
    transparent:  transparent;

    background-color: @transparent;
    text-color: @fg;
}

window {
    width: 1100px;
    border: 2px solid;
    border-color: @border;
    border-radius: 15px;
    background-color: @bg;
}

mainbox {
    background-color: @transparent;
    children: [imagebox, right-pane];
    spacing: 0px;
    orientation: horizontal;
}

/* ---------- left: preview image ---------- */
imagebox {
    background-color: @bg-alt;
    border: 0px 2px 0px 0px;
    border-color: @border;
    border-radius: 13px 0px 0px 13px;
    padding: 20px;
    children: [image-dummy];
    expand: true;
    width: 480px;
}

image-dummy {
    background-image: url("/tmp/wallpaper-preview.jpg", width);
    size: 460px;
    border-radius: 8px;
}

/* ---------- right: input + list ---------- */
right-pane {
    children: [inputbar, listview];
    spacing: 10px;
    padding: 20px;
    expand: true;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 10px;
    padding: 12px 16px;
    spacing: 8px;
    children: [prompt, entry];
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder: "Search wallpapers...";
    placeholder-color: @fg-alt;
}

listview {
    background-color: @transparent;
    columns: 1;
    lines: 14;
    spacing: 4px;
    scrollbar: true;
    border: 0px;
}

scrollbar {
    width: 4px;
    background-color: @bg-alt;
    handle-color: @accent;
    handle-width: 4px;
    border-radius: 4px;
}

element {
    background-color: @transparent;
    padding: 10px 12px;
    border-radius: 6px;
    spacing: 10px;
}

element normal.normal {
    background-color: @transparent;
    text-color: @fg;
}

element normal.urgent {
    background-color: @urgent;
    text-color: @bg;
}

element normal.active {
    background-color: @bg-alt;
    text-color: @accent;
}

element selected.normal {
    background-color: @bg-selected;
    text-color: @fg;
    border: 0px 0px 0px 3px;
    border-color: @accent;
}

element selected.urgent {
    background-color: @urgent;
    text-color: @bg;
}

element selected.active {
    background-color: @bg-selected;
    text-color: @accent;
}

element alternate.normal {
    background-color: @transparent;
    text-color: @fg;
}

element alternate.urgent {
    background-color: @urgent;
    text-color: @bg;
}

element alternate.active {
    background-color: @transparent;
    text-color: @accent;
}

element-icon {
    size: 24px;
    background-color: @transparent;
    cursor: inherit;
}

element-text {
    background-color: @transparent;
    text-color: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}
